rules_version = '2';
// Beveiliging van de Bierproeverij-database: elke proeverij is alleen zichtbaar voor haar leden.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function grp(g) { return get(/databases/$(db)/documents/groups/$(g)).data; }
    function member(g) { return signedIn() && request.auth.uid in grp(g).members; }
    function admin(g) { return signedIn() && (request.auth.uid in grp(g).admins || request.auth.uid == grp(g).owner); }

    match /users/{u} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == u; }
    match /codes/{c} { allow read: if signedIn(); allow create: if signedIn(); }

    match /groups/{g} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update, delete: if admin(g);
      match /requests/{u} {
        allow create: if signedIn() && request.auth.uid == u;
        allow read, delete: if admin(g) || (signedIn() && request.auth.uid == u);
      }
      match /{col}/{doc=**} { allow read, write: if member(g); }
    }

    // Gedeeld door alle proeverijen
    match /catalog_extra/{d} { allow read, write: if signedIn(); }
    match /prijzen/{d} { allow read: if signedIn(); allow write: if signedIn(); }
  }
}
